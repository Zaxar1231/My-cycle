    <string name="breathing_478_description">Breathe in for 4, hold for 7, breathe out for 8. Many people find the long exhale calming before sleep.</string>
    <string name="breathing_box_description">Breathe in, hold, breathe out and hold, 4 counts each. Helps to focus and steady the breath.</string>
    <string name="breathing_slow_description">About six breaths a minute with a longer exhale. Some people find it relaxing during cramps.</string>
