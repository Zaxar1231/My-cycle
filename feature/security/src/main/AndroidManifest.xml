<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Unlock by fingerprint or face through the system BiometricPrompt. A normal permission:
         granted at install, no dialog, no access to biometric data itself. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
</manifest>
