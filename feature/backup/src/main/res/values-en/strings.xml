    <string name="data_restore">Restore from a backup</string>
    <string name="data_backup_note">The backup is encrypted with your password (AES-256). It cannot be opened without the password, and the password cannot be recovered.</string>
    <string name="data_backup_password_title">Backup password</string>
    <string name="data_backup_password_text">Remember it: the backup cannot be restored without it.</string>
    <string name="data_restore_title">Restore from the backup?</string>
    <string name="data_restore_text">All current logs, cycles, medications and affirmations are replaced with the backup\'s data (the backup holds only favourite affirmations). The pet is replaced if the backup has one.</string>
