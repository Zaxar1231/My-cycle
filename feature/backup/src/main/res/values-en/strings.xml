<resources>
    <string name="data_intro">Files are made on the phone and saved where you choose. The app does not send them anywhere.</string>
    <string name="data_report">PDF report for the doctor</string>
    <string name="data_report_note">The PDF is not encrypted: it holds a cycle summary, frequent symptoms and medications. Notes, sex and weight are left out.</string>
    <string name="data_csv">Table of logs (CSV)</string>
    <string name="data_csv_note">CSV is not encrypted: any app with access to the file can read it.</string>
