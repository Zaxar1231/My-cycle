<?xml version="1.0" encoding="utf-8"?>
<!-- The heart-shaped cloud picture fills the icon; launchers crop it to their shape.
     Themed (monochrome) icons keep the simple vector mark. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_art" />
    <foreground android:drawable="@drawable/ic_launcher_clear" />
    <monochrome android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
